# Optional: without it only the built-in sample questions work.
OPENAI_API_KEY=sk-your-key
SQLITE_DB_PATH=/absolute/path/to/database.sqlite
ASKDB_API_KEY=change-me-local-key
# required (default): every request needs the key. optional: no key needed (testing only).
ASKDB_AUTH_MODE=required
ASKDB_OPENAI_MODEL=gpt-4o-mini
ASKDB_HOST=127.0.0.1
ASKDB_PORT=8765
ASKDB_PENDING_TTL_SECONDS=3600
ASKDB_MAX_ROWS=100

# Create the sample DB on startup if it is missing (defaults on for Vercel without SQLITE_DB_PATH).
# ASKDB_SEED_DEMO_DB=false
